HOST=127.0.0.1
PORT=8080
DATABASE_PATH=/opt/animeuta/shared/data/animeuta.sqlite
MEDIA_ROOT=/opt/animeuta/shared/media
AUDIO_LIBRARY_ROOTS=/opt/animeuta/shared/music
TOMOSHI_DICTIONARY_PATH=/opt/animeuta/shared/dictionaries/tomoshi-dict-open.db
APP_ORIGIN=http://127.0.0.1:18090
REGISTRATION_MODE=closed
# Generate once before starting: openssl rand -hex 32
MEDIA_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET
# Set external provider details privately on the server before using AI.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=20
