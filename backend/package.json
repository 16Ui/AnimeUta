{
  "name": "animeuta-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "catalog:build": "node scripts/build-online-catalog.mjs",
    "prebuild": "npm run catalog:build",
    "pretest": "npm run catalog:build",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/build-assets.mjs",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "backup": "tsx src/backup.ts",
    "restore": "tsx src/restore.ts",
    "account:reset-password": "tsx src/reset-password.ts",
    "dictionary:setup": "node scripts/setup-dictionary.mjs",
    "library:import": "tsx src/import-library.ts",
    "library:link": "tsx src/link-audio.ts",
    "lyrics:calibrate": "tsx src/calibrate-lyrics.ts",
    "lyrics:repair-tracks": "tsx src/repair-lyric-tracks.ts",
    "lyrics:audit-furigana": "tsx src/audit-furigana.ts",
    "ai:check": "tsx src/check-ai.ts",
    "ai:acceptance": "tsx src/accept-ai.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "fastify": "^5.12.3",
    "fzstd": "^0.1.1",
    "ipaddr.js": "^2.5.0",
    "kuromoji": "^0.1.2",
    "music-metadata": "^11.15.0",
    "opencc-js": "^1.4.2",
    "quickjs-emscripten": "^0.32.0",
    "ts-fsrs": "^5.4.2",
    "wanakana": "^5.3.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.5.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "yazl": "^3.3.1"
  }
}
