HOST=127.0.0.1
PORT=8080
DATABASE_PATH=./data/animeuta.sqlite
TOMOSHI_DICTIONARY_PATH=./data/dictionaries/tomoshi-dict-open.db
MEDIA_ROOT=./data/media
# Local library imports reference these folders without copying audio. Separate roots with semicolons.
AUDIO_LIBRARY_ROOTS=
APP_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,https://localhost,capacitor://localhost,http://tauri.localhost,https://tauri.localhost
REGISTRATION_MODE=invite
FRIEND_SHARE_REVIEW=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=AnimeUta Admin
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
MAX_AUDIO_BYTES=104857600
MAX_IMAGE_BYTES=10485760
MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_TIMEOUT_SECONDS=1800
AI_DAILY_LIMIT=20
LLM_API_KEY=
